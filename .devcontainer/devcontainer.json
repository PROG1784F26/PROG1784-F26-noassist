{
  "name": "PROG1784-F26-noassist Python",
  "dockerComposeFile": [
    "compose.yaml",
    "compose.runtime.yaml"
  ],
  "initializeCommand": [
    "docker",
    "run",
    "--rm",
    "--user",
    "0",
    "--volume",
    "${localWorkspaceFolder}/.devcontainer:/config:z",
    "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
    "python",
    "/config/configure_runtime.py"
  ],
  "service": "python",
  "runServices": [
    "python"
  ],
  "workspaceFolder": "/workspaces/PROG1784-F26-noassist",
  "remoteUser": "vscode",
  "userEnvProbe": "none",
  "remoteEnv": {
    "VIRTUAL_ENV": "/home/vscode/.venv",
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.inlineSuggest.enabled": false,
        "editor.suggest.preview": false,
        "github.copilot.enable": {
          "*": false,
          "python": false,
          "markdown": false,
          "plaintext": false,
          "scminput": false
        },
        "github.copilot.editor.enableAutoCompletions": false,
        "github.copilot.nextEditSuggestions.enabled": false,
        "github.copilot.nextEditSuggestions.fixes": false,
        "github.copilot.renameSuggestions.triggerAutomatically": false,
        "chat.disableAIFeatures": true
      }
    }
  }
}
